{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "removeComments": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "#/*": ["../shared/*"]
        }
    },
    "include": ["src/**/*"]
}