{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./src/*"],
            "#/*": ["../../shared/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.vue"]
}